    style RuntimeLayer fill:#f0f9ff,stroke:#38bdf8
    style CalibrationLayer fill:#fef2f2,stroke:#f87171
    style ModuleA fill:#ecfeff,stroke:#22d3ee
    style ModuleB fill:#f7fee7,stroke:#a3e635
    style ModuleC1 fill:#fff1f2,stroke:#fb7185
    style ModuleC2 fill:#f0fdf4,stroke:#4ade80
